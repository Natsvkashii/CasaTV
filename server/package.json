{
  "name": "casatv-server",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "description": "CasaTV — local IPTV catalog, HLS proxy and API server",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --no-warnings src/index.js",
    "desktop": "npm --prefix ../desktop start",
    "dev": "node --no-warnings --watch src/index.js",
    "ingest": "node --no-warnings src/cli-ingest.js",
    "test": "node --no-warnings --test"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "bonjour-service": "^1.4.4",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.7",
    "hls.js": "^1.7.3"
  }
}
